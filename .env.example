# Copy to .env locally. Never commit real credentials.
# This file documents future model/MCP integration; no executor is connected yet.
SAM_MODEL_PROVIDER=minimax
SAM_MODEL=MiniMax-M2
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Second Shift MCP: supply your actual MCP endpoint and token locally.
# SAM will not connect until an authenticated MCP adapter is implemented.
SECOND_SHIFT_MCP_URL=
SECOND_SHIFT_MCP_TOKEN=

# Additional providers are not env blocks. Register them with
# `sam providers add <id> --endpoint <url> --key-env <ENV_NAME> --model <id>`
# and put the key in that env var. The providers file stores the name only.
# Pin a profile with `sam agents set-provider <profile> <id>`.

# Optional local runtime settings
SAM_LOG_LEVEL=info
