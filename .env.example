# SAM's one configuration file: <workspace>/sam.env
#
# You do not need to write it by hand: `sam setup` (or
# scripts/install.sh on a fresh clone) asks for your model key with
# hidden input, verifies it with one real model call, and only then
# writes this file with mode 0600. Every sam command loads the
# workspace's sam.env automatically; a value in your real environment
# always wins over the file. Copy this template only if you prefer to
# write the file yourself. Never commit a filled-in copy.
SAM_MODEL_PROVIDER=minimax
SAM_MODEL=MiniMax-M2.5
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Second Shift MCP: supply your actual MCP endpoint and token locally.
# MCP connectors are implemented (read-only, default-deny, pinned per
# profile); a connector connects once its endpoint and token env are set.
SECOND_SHIFT_MCP_URL=
SECOND_SHIFT_MCP_TOKEN=

# Additional providers are not env blocks. Register them with
# `sam providers add <id> --endpoint <url> --key-env <ENV_NAME> --model <id>`
# and put the key in that env var. The providers file stores the name only.
# Pin a profile with `sam agents set-provider <profile> <id>`.

# Optional local runtime settings
SAM_LOG_LEVEL=info
